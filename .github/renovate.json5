{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'github>stackitcloud/ske-ci-infra//config/renovate/ske.json5',
  ],
  dependencyDashboard: true,
  postUpdateOptions: [
    'gomodTidy',
  ],
  separateMinorPatch: true,
  additionalReviewers: [
    'team:ske-security',
  ],
  labels: [
    'kind/upgrade',
  ],
  commitMessagePrefix: '🤖',
  customManagers: [
    {
      description: 'Update `_VERSION` and `_version` variables in Makefiles and scripts. Inspired by `regexManagers:dockerfileVersions` preset.',
      customType: 'regex',
      managerFilePatterns: [
        '/Makefile$/',
        '/\\.mk$/',
        '/\\.sh$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\s.+?_(VERSION|version) *[?:]?= *"?(?<currentValue>.+?)"?\\s',
      ],
    },
    {
      description: 'Update Kata version and reset package release to 0 in KATA_VERSION',
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)KATA_VERSION$/',
      ],
      matchStrings: [
        'KATA_VERSION *[?:]?= *"?(?<currentValue>[^\\s"]+?)"?\\s[\\s\\S]*?KATA_PACKAGE_RELEASE *[?:]?= *"?[^\\s"]+?"?\\s',
      ],
      autoReplaceStringTemplate: 'KATA_VERSION := {{{newVersion}}}\n# Release counter that can be incremented if it becomes necessary to update the kata configuration\n# without also changing the kata version at the same time\nKATA_PACKAGE_RELEASE := 0\n',
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'kata-containers/kata-containers',
    },
    {
      description: 'Update Kata installation image tag in imagevector/images.yaml',
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)imagevector/images\\.yaml$/',
      ],
      matchStrings: [
        'tag: "?(?<currentValue>[^"\\s-]+)(?:-[^"\\s]+)?"?\\s',
      ],
      autoReplaceStringTemplate: 'tag: {{{newVersion}}}-0\n',
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'kata-containers/kata-containers',
    },
  ],
  packageRules: [
    {
      groupName: 'Kata Dependencies',
      matchPackageNames: [
        'kata-containers/kata-containers',
      ],
    },
    {
      groupName: 'gardener/gardener',
      matchPackageNames: [
        'github.com/gardener/gardener',
        'github.com/gardener/gardener/pkg/apis',
        'github.com/gardener/gardener/hack/tools',
      ],
    },
    {
      description: 'dependencies are updated alongside gardener/gardener',
      enabled: false,
      matchDatasources: [
        'go',
      ],
      matchPackageNames: [
        '/k8s.io/',
        '/sigs.k8s.io/controller-runtime/',
      ],
    },
    {
      description: 'Disable docker datasource update for installation image because it is updated alongside KATA_VERSION via github-releases',
      enabled: false,
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/stackitcloud/gardener-extension-runtime-kata/gardener-extension-runtime-kata-installation',
      ],
    },
    {
      groupName: 'Go testing',
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      addLabels: [
        'skip-review',
      ],
      matchSourceUrls: [
        'https://github.com/onsi/gomega{/,}**',
        'https://github.com/onsi/ginkgo{/,}**',
      ],
    },
  ],
}
